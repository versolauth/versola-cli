{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(gofmt -l *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "deny": [
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh release *)",
      "Read(~/.versola/**)",
      "Edit(~/.versola/**)",
      "Read(**/*.secrets.env)",
      "Read(**/*.generated-secrets.env)",
      "Edit(**/*.secrets.env)",
      "Edit(**/*.generated-secrets.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go run ./.claude/hooks/claudehook pre-shell",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go run ./.claude/hooks/claudehook post-edit",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  }
}
