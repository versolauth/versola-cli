# Locally-built binaries. Patterns rather than an explicit list: release
# binaries are built by CI and published as release assets, never committed,
# so anything matching these at the repo root is a local build artifact.
/versola
/versola.exe
/versola-*
/dist/
.idea/
# Personal Claude Code settings; the shared ones are .claude/settings.json.
.claude/settings.local.json
