# by hand.
#
# vps: auth's mutual-TLS listener (MPORT) where edge reaches it
# (auth-mutual-tls-url, 127.0.0.1:{{ .MutualTLSListen }}), balanced over every
# auth replica. Bytes are passed through: auth terminates TLS itself, with
# its own certificate (the one edge pins) and checking the caller's client
# certificate. Loopback only.
upstream auth_mutual_tls {
    least_conn;
{{- range .MutualTLSUpstreams }}
    server {{ . }} max_fails=3 fail_timeout=10s;
{{- end }}
}

server {
    listen 127.0.0.1:{{ .MutualTLSListen }};
    proxy_pass auth_mutual_tls;
    proxy_connect_timeout 5s;
    # A pass-through connection is closed after this long without a byte
    # either way (nginx's default is 10 minutes): edge keeps its mutual-TLS
    # connections pooled, and reconnects when one is closed.
    proxy_timeout 1h;
}
