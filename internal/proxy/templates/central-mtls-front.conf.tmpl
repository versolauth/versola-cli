# Generated by versola-cli -- rewritten whenever replicas change, don't edit
# by hand.
#
# vps: central's mutual-TLS listener (MPORT) where edges reach it
# (port {{ .CentralMTLSListen }} on every interface, as central itself listened before),
# balanced over every central replica. Bytes are passed through: central
# terminates TLS itself, with its own certificate (the one edge pins) and
# checking the edge's client certificate. Each replica listens elsewhere, on
# the loopback (see the upstream below); the 443 relay (central-mtls.conf)
# also comes in through here.
upstream central_mutual_tls {
    least_conn;
{{- range .CentralMTLSUpstreams }}
    server {{ . }} max_fails=3 fail_timeout=10s;
{{- end }}
}

server {
    listen {{ .CentralMTLSListen }};
    proxy_pass central_mutual_tls;
    proxy_connect_timeout 5s;
    # A pass-through connection is closed after this long without a byte
    # either way (nginx's default is 10 minutes): edge keeps its connections
    # to central pooled, and reconnects when one is closed.
    proxy_timeout 1h;
}
