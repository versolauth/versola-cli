# Generated by versola-cli (`versola configure`) -- rewritten on every
# configure, don't edit by hand.
#
# Port 443 is shared by two things that must not both terminate TLS here:
#
#   {{ .CentralHost }}  central's edge surface. Passed through byte for byte to
#                       central's own mutual-TLS listener (127.0.0.1:{{ .CentralPort }},
#                       through the relay below): the
#                       handshake, central's own certificate (the one edge
#                       pins) and the edge's client certificate never touch
#                       nginx, which is why this is the stream module.
#   anything else       the http server of versola.conf, now on
#                       127.0.0.1:{{ .FrontPort }} and still the one with the ACME certificate:
#                       {{ .Host }}, and also what a client sends no SNI
#                       with. Port 80 (Let's Encrypt HTTP-01) is unchanged.
#
# The name is read from the ClientHello (ssl_preread), nothing is decrypted.
# `hostnames` matches the name case-insensitively.
map $ssl_preread_server_name $versola_public_upstream {
    hostnames;
    {{ .CentralHost }} 127.0.0.1:{{ .RelayPort }};
    default 127.0.0.1:{{ .FrontPort }};
}

# Every connection leaves with a PROXY protocol header, which is how the
# http server learns the client's address (nginx's `proxy_protocol` is a
# switch of the server, it cannot depend on the name). Central's listener
# must not see it -- it would take the header for a broken handshake -- so
# its connections go through the relay below, which reads the header and
# forwards the rest untouched.
server {
    listen 443;
{{- if .IPv6 }}
    listen [::]:443;
{{- end }}
    ssl_preread on;
    proxy_pass $versola_public_upstream;
    proxy_protocol on;
    proxy_connect_timeout 5s;
    # Idle time before a connection is closed (nginx's default is 10
    # minutes): edge keeps its connections to central pooled and reconnects
    # when one is closed.
    proxy_timeout 1h;
}

server {
    listen 127.0.0.1:{{ .RelayPort }} proxy_protocol;
    proxy_pass 127.0.0.1:{{ .CentralPort }};
    proxy_connect_timeout 5s;
    proxy_timeout 1h;
}
