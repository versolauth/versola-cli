# Generated by versola-cli -- rewritten whenever replicas change, don't edit
# by hand.
#
# vps: auth's additional listener (APORT) where edge and central reach it
# (auth-additional-url, 127.0.0.1:{{ .AdditionalListen }}), balanced over every
# auth replica. Each replica itself listens elsewhere (see the
# auth_additional upstream in upstreams.conf); without this, every caller
# would reach only the first one. Loopback only: nothing outside this host
# talks to it.
server {
    listen 127.0.0.1:{{ .AdditionalListen }};

    # As close to calling auth directly as before: no access log (these are
    # service-to-service calls, which never went through a logging hop), no
    # body size limit, and no read timeout shorter than a slow call's.
    access_log off;
    client_max_body_size 0;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://auth_additional;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # The caller's Host, as it would reach auth directly.
        proxy_set_header Host $http_host;
    }
}
