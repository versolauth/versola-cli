# Generated by versola-cli. The official nginx:1.30-alpine image's stock
# nginx.conf, plus the load_module line right below, a relative conf.d
# include, and on vps the stream block at the end:
# ngx_http_acme_module (nginx's own Let's Encrypt client, shipped in the
# official image since 1.29.1) is a dynamic module and can only be loaded
# here, in the main context -- conf.d/ is inside `http`, too late for it.
# Loaded unconditionally: harmless when no acme_issuer is configured.
#
# When bumping the image, re-diff against its stock file:
#   docker run --rm nginx:<version>-alpine cat /etc/nginx/nginx.conf
load_module modules/ngx_http_acme_module.so;

user  nginx;
worker_processes  auto;

# A reload (replicas added or removed) lets the old workers finish their
# requests, but not for longer than this.
worker_shutdown_timeout 30s;

error_log  /var/log/nginx/error.log notice;
pid        /run/nginx.pid;


events {
    worker_connections  1024;
}


http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;

    #gzip  on;

    # Relative: from the directory this file is in -- /etc/nginx in the
    # local proxy, the current config generation on vps (see package proxy,
    # generation.go).
    include conf.d/*.conf;
}
{{- if .Stream }}

# vps: plain TCP pass-through in front of auth's mutual-TLS listener (MPORT),
# and on 443 in front of central's (central.<domain>, by SNI).
# TLS stays end to end between the caller (edge) and auth/central -- their own
# certificates, the caller's client certificate -- so it has to be the stream
# module, not an http proxy; and stream is a block of its own, beside http.
stream {
    include stream.d/*.conf;
}
{{- end }}
