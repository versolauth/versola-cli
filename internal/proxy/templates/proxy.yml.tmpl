# Generated by versola-cli (`versola configure`) -- rewritten on every
# configure, don't edit by hand.
#
# The reverse proxy in front of auth/edge: the official nginx image (not a
# Versola one), configured entirely by the files next to this one. Same
# compose project as compose.yml (versola-tools' file), and versola-cli
# always passes both -- so `down`, `status` and friends always see it.
name: versola-vps

services:
  proxy:
    image: {{ .Image }}
    container_name: {{ .ContainerName }}
    restart: unless-stopped
    # Same as auth/edge: they bind 127.0.0.1 only, so the proxy has to
    # share the host's network namespace to reach them -- and binds the
    # host's ports directly (80/443, or 127.0.0.1:2821 behind an external
    # proxy).
    network_mode: host
    volumes:
      - ./proxy/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./proxy/conf.d:/etc/nginx/conf.d:ro
      - ./proxy/proxy_params.conf:/etc/nginx/proxy_params.conf:ro
      # The built admin console, copied into this bundle by versola-tools.
      - ./central-ui:/usr/share/nginx/html/central/admin:ro
{{- if .TLS }}
      - {{ .ACMEVolume }}:/var/cache/nginx/acme-letsencrypt

# External, like OpenBao's volume: survives `versola down --volumes`, so
# a redeploy doesn't request a new certificate (Let's Encrypt allows only a
# few duplicates a week). versola-cli creates it during configure.
volumes:
  {{ .ACMEVolume }}:
    external: true
{{- end }}
