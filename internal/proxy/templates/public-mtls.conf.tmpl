# Generated by versola-cli (`versola configure`) -- rewritten on every
# configure, don't edit by hand.
#
# Port 443 is shared by two kinds of TLS that must not both be terminated here:
#
{{- range .Relays }}
#   {{ .Name }}
#       the {{ .Label }} service's mutual-TLS listener. Passed through byte for byte
#       to 127.0.0.1:{{ .To }} (through a relay below): the handshake, the
#       service's own leaf certificate (the one an edge pins) and the caller's
#       client certificate never touch nginx, which is why this is the stream
#       module.
{{- end }}
#   anything else
#       the http server of versola.conf, now on 127.0.0.1:{{ .FrontPort }} and still the
#       one with the ACME certificate: {{ .Host }}{{ if .Enroll }}, {{ .EnrollHost }} (an edge's first
#       certificate: POST /edge/enroll only),{{ end }} and also what a client sends no
#       SNI with. Port 80 (Let's Encrypt HTTP-01) is unchanged.
#
# The name is read from the ClientHello (ssl_preread), nothing is decrypted.
# `hostnames` matches the name case-insensitively.
#
# The listeners the services are reached on from this host (127.0.0.1:8083
# for auth and for central, the proxy's fronts of the replicas) are not touched by any of this: no
# SNI, no limits. They are what a local edge uses, by address, never by a
# public name. What follows is only the public way in.
map $ssl_preread_server_name $versola_public_upstream {
    hostnames;
{{- range .Relays }}
    {{ .Name }} 127.0.0.1:{{ .Port }};
{{- end }}
    default 127.0.0.1:{{ .FrontPort }};
}

# The mutual-TLS names are logged, one line per connection, in a log of
# their own: tagged `mtls-public` on the proxy's stdout (docker logs, and
# whatever collects it -- a file inside the container would never be
# rotated). The browsers' connections are not: the http server logs them.
map $ssl_preread_server_name $versola_public_logged {
    hostnames;
{{- range .Relays }}
    {{ .Name }} 1;
{{- end }}
    default 0;
}

log_format versola_public 'mtls-public $remote_addr [$time_local] sni=$ssl_preread_server_name '
                          '$status in=$bytes_received out=$bytes_sent time=$session_time';

# Every connection leaves with a PROXY protocol header, which is how the
# http server learns the client's address (nginx's `proxy_protocol` is a
# switch of the server, it cannot depend on the name). The services' TLS
# listeners must not see it -- they would take the header for a broken
# handshake -- so their connections go through the relays below, which read
# the header and forward the rest untouched.
server {
    listen 443;
{{- if .IPv6 }}
    listen [::]:443;
{{- end }}
    ssl_preread on;
    proxy_pass $versola_public_upstream;
    proxy_protocol on;
    proxy_connect_timeout 5s;
    # Idle time before a connection is closed (nginx's default is 10
    # minutes): an edge keeps its connections pooled and reconnects when
    # one is closed.
    proxy_timeout 1h;
    access_log /dev/stdout versola_public if=$versola_public_logged;
}

# The public servers, one per mutual-TLS name. The only place a limit can
# apply before TLS: connections held open per client address, counted on the
# address the PROXY protocol header carries (this listener's own peer is
# always the 443 server above). Refused connections are logged by nginx
# at warn level, in its error log.
limit_conn_zone $proxy_protocol_addr zone=versola_public_conn:10m;
{{ range .Relays }}
log_format versola_public_{{ .Label }} 'mtls-public {{ .Name }} $proxy_protocol_addr [$time_local] '
                                       '$status in=$bytes_received out=$bytes_sent time=$session_time';

server {
    listen 127.0.0.1:{{ .Port }} proxy_protocol;
    limit_conn versola_public_conn {{ $.ConnLimit }};
    limit_conn_log_level warn;
    access_log /dev/stdout versola_public_{{ .Label }};
    proxy_pass 127.0.0.1:{{ .To }};
    proxy_connect_timeout 5s;
    proxy_timeout 1h;
}
{{ end }}
