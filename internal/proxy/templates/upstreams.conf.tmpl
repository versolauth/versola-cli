# Generated by versola-cli -- rewritten on every configure and whenever
# replicas change, don't edit by hand.

# auth/edge: on the host's loopback (vps, network_mode: host) or by
# compose service name (local, bridge network). Kept as upstream blocks
# of their own, in a file of their own: adding or removing a replica
# rewrites this file and reloads nginx, nothing else.
{{- if .Resolve }}
#
# local: service names are re-resolved at runtime through Docker's
# embedded DNS (`resolve`, needs `zone`), not once at startup -- after a
# Docker Desktop restart auth/edge can come back with new addresses, or
# after the proxy.
resolver 127.0.0.11 valid=10s ipv6=off;
{{- end }}
upstream auth_backend {
{{- if .Resolve }}
    zone auth_backend 64k;
{{- range .AuthUpstreams }}
    server {{ . }} resolve max_fails=3 fail_timeout=10s;
{{- end }}
{{- else }}
{{- range .AuthUpstreams }}
    server {{ . }} max_fails=3 fail_timeout=10s;
{{- end }}
{{- end }}
    least_conn;
    keepalive 32;
}

upstream edge_backend {
{{- if .Resolve }}
    zone edge_backend 64k;
{{- range .EdgeUpstreams }}
    server {{ . }} resolve max_fails=3 fail_timeout=10s;
{{- end }}
{{- else }}
{{- range .EdgeUpstreams }}
    server {{ . }} max_fails=3 fail_timeout=10s;
{{- end }}
{{- end }}
    least_conn;
    keepalive 32;
}
{{- if .Fronted }}

# vps: auth's additional listener (APORT) on every replica, for the server
# in internal.conf. edge and central reach it at 127.0.0.1:{{ .AdditionalListen }}.
upstream auth_additional {
{{- range .AdditionalUpstreams }}
    server {{ . }} max_fails=3 fail_timeout=10s;
{{- end }}
    least_conn;
    keepalive 32;
}
{{- end }}
{{- if .CentralFronted }}

# vps: central's PORT on every central replica, for the server in central.conf.
# auth, edge and the admin console's resource reach central at
# 127.0.0.1:{{ .CentralListen }}, wherever its replicas listen.
upstream central_backend {
{{- range .CentralUpstreams }}
    server {{ . }} max_fails=3 fail_timeout=10s;
{{- end }}
    least_conn;
    keepalive 32;
}
{{- end }}
