# Generated by versola-cli (`versola configure`) -- rewritten on every
# configure, don't edit by hand.

# The auth_backend / edge_backend upstreams are in upstreams.conf: the one
# file rewritten and reloaded when replicas are added or removed.

# Host passed upstream exactly as the client sent it, port included
# ($host drops it) -- behind an external proxy on a non-default port the
# advertised origin carries that port. $host only when the header is
# missing altogether (HTTP/1.0).
map $http_host $versola_host {
    ""      $host;
    default $http_host;
}
{{- if .RealIP }}

# The scheme the client actually used: the external proxy in front
# terminates TLS and talks plain HTTP to us, so $scheme here is always
# "http". Its X-Forwarded-Proto is trusted -- only processes on this host
# can reach 127.0.0.1:{{ .ExternalPort }}.
map $http_x_forwarded_proto $versola_forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}
{{- else }}

# Clients reach this proxy directly: its own scheme is the truth, and a
# client-sent X-Forwarded-Proto is ignored.
map $scheme $versola_forwarded_proto {
    default $scheme;
}
{{- end }}
{{- if .TLS }}

# TLS: nginx's ACME module issues and renews the certificate itself.
# `resolver` is needed for it to reach the ACME server; taken from the
# host's resolv.conf. ipv6=off without a global IPv6 address, so the
# client never picks an AAAA record it can't connect to.
resolver {{ .Resolvers }}{{ if not .IPv6 }} ipv6=off{{ end }};

acme_issuer letsencrypt {
    uri {{ .ACMEDirectory }};
    # A docker volume (versola-acme-vps): without persistent state every
    # restart would request a new certificate and run into Let's
    # Encrypt's rate limits.
    # Separate state per ACME directory, so a staging certificate from a
    # test deploy is never served after switching to production.
    state_path /var/cache/nginx/acme-letsencrypt/{{ .ACMEStateDir }};
    accept_terms_of_service;
}

# Port 80: the ACME module answers HTTP-01 challenges here; everything
# else is sent to https.
server {
    listen 80;
{{- if .IPv6 }}
    listen [::]:80;
{{- end }}
    server_name {{ .Host }}{{ if .Enroll }} {{ .EnrollHost }}{{ end }};

    location / {
        return 301 https://$host$request_uri;
    }
}
{{- end }}

server {
{{- range .Listen }}
    listen {{ . }};
{{- end }}
    server_name {{ .Host }};

    # Redirects nginx generates itself (the /admin -> /central/admin/
    # returns in the routes below, trailing-slash redirects) stay
    # relative: absolute ones would carry nginx's own scheme and port --
    # http://<host>:2821 behind an external proxy, unreachable from
    # outside.
    absolute_redirect off;
{{- if .TLS }}

    http2 on;
    acme_certificate letsencrypt;
    ssl_certificate $acme_certificate;
    ssl_certificate_key $acme_certificate_key;
    ssl_certificate_cache max=2;
{{- end }}
{{- if .RealIP }}

    # Behind the host's own reverse proxy (--proxy external): trust
    # X-Forwarded-For only from it (127.0.0.1), and only its last entry --
    # the address that proxy saw. Without this auth, which reads the client
    # IP from X-Real-IP for per-IP throttling, would see 127.0.0.1 for
    # everyone. That proxy must set X-Forwarded-For itself
    # ($proxy_add_x_forwarded_for), or a client-supplied value would pass
    # through and be trusted here.
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
{{- end }}
{{- if .ProxyProtocol }}

    # Reached only through the stream server on 443 (public-mtls.conf),
    # which sends a PROXY protocol header first: $remote_addr is the
    # client's real address again, not 127.0.0.1 -- auth reads the client
    # IP from X-Real-IP for per-IP throttling. Only that loopback peer is
    # trusted to say so, and every connection to this listener has to
    # carry the header, so nothing else can get here with a made-up one.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
{{- end }}

{{ .Routes -}}
}
{{- if .Enroll }}

# {{ .EnrollHost }}: where an edge gets its first certificate (POST /edge/enroll,
# a one-time token and a CSR, no client certificate yet), TLS terminated here
# like the auth URL's, with a certificate of its own from the same ACME issuer.
# Nothing else is served on it, and the request goes to central's enrollment
# listener (127.0.0.1:{{ .EnrollPort }}), which serves nothing else either.
#
# Attempts are limited per client address, before central ever sees them:
# a token is guessable only by trying, and each try costs a request here.
# (central limits per token on its side, and answers a wrong and a used
# token the same way.)
limit_req_zone $binary_remote_addr zone=versola_enroll:1m rate=6r/m;

server {
{{- range .Listen }}
    listen {{ . }};
{{- end }}
    server_name {{ .EnrollHost }};
    absolute_redirect off;
{{- if .TLS }}

    http2 on;
    acme_certificate letsencrypt;
    ssl_certificate $acme_certificate;
    ssl_certificate_key $acme_certificate_key;
    ssl_certificate_cache max=2;
{{- end }}
{{- if .ProxyProtocol }}

    # Same as the auth URL's server above: the stream server on 443 shares
    # this listener and says who the client was.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
{{- end }}

    location = /edge/enroll {
        limit_except POST { deny all; }
        limit_req zone=versola_enroll burst=5 nodelay;
        limit_req_status 429;
        # A CSR and a token: a few KB.
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:{{ .EnrollPort }};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Overwritten, not appended: nothing before this proxy is trusted
        # to say who the client was.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }

    location / {
        return 404;
    }
}
{{- end }}
